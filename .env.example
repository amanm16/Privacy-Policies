# Copy this file to .env and fill it in.

# "production" on the server, "development" on your machine.
NODE_ENV=production

# Port the Node server listens on. Put nginx (or another proxy) in front for HTTPS.
PORT=4000
# Uncomment to accept connections only from a proxy on the same machine.
# HOST=127.0.0.1

# MongoDB connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/privacy_policies

# Public address of this site, without a trailing slash, e.g. https://privacy.m16labs.com
# Used for canonical links and the "Copy link" button in the admin.
PUBLIC_BASE_URL=

# Signs admin sessions. Required in production: at least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional. Lets scripts and CI call the admin API with "Authorization: Bearer <token>".
# At least 32 characters. Leave empty to turn token access off.
API_TOKEN=

# Heading of the page at "/" that lists every published policy.
SITE_NAME=Privacy Policies

# Set to false to hide that list ("/" then returns 404).
SHOW_INDEX=true

# Proxies to trust for the client IP and HTTPS detection.
# "loopback" suits nginx on the same machine; use a number (hops) or "false" otherwise.
TRUST_PROXY=loopback
